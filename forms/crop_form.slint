import { VerticalBox, Date } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";
import { UILineEdit } from "../UI/ui_line_edit.slint";
import { UIComboBox } from "../UI/ui_combo_box.slint";
import { UIDatePicker } from "../UI/ui_date_picker.slint";
import { CropData } from "../models/crop_data.slint";

export component CropForm inherits VerticalBox {
    callback save-crop(
        CropData
    );
    callback cancel();
    
    spacing: 10px;

    in property <Date> current-date;
    in property <bool> editing: false;
    in-out property <CropData> crop; 


    Text {
        text: root.editing ? "Edit" : "New";
        font-size: 18px;
        font-weight: 700;
        color: #022817;
    }

    Text {
        text: "Name";
        color: #022817;
    }


    UILineEdit {
        _text <=> root.crop.name;
    }



    Text {
        text: "Area";
        color: #022817;
    }


    UILineEdit {
        _text <=> root.crop.area;
    }

    Text {
        text: "Measurement unit";
        color: #022817;
    }

    UIComboBox {
        _model: ["m²", "hectares", "acres"];
        _current-value <=> root.crop.area-unit;
    }

    Text {
        text: "Crop";
        color: #022817;
    }

    UILineEdit {
        _text <=> root.crop.crop;
    }

    Text {
        text: "Planting date (YYYY-MM-DD)";
        color: #022817;
    }

    UIDatePicker {
        _date: root.current_date;
        date_string <=> root.crop.planting-date;
    }

    Text {
        text: "Status";
        color: #022817;
    }

    UIComboBox {
        _model: ["Growing", "Harvested", "Fallow", "Prepared"];
        _current-value <=> root.crop.status;
    }

    UiButton {
        label: root.editing ? "Save Changes" : "Save";
        clicked => {
            if root.crop.name != "" &&
                root.crop.area != "" {
                root.save-crop(
                    crop
                );
            }
        }
    }

    UiButton {
        label: "Cancel";
        button-color: #59665c;
        clicked => {
            root.cancel();
        }
    }
}