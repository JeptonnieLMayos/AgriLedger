
import { VerticalBox, LineEdit, ComboBox, Date } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";
import { UILineEdit } from "../UI/ui_line_edit.slint";
import { UIComboBox } from "../UI/ui_combo_box.slint";
import { UIDatePicker } from "../UI/ui_date_picker.slint";
import { FieldForm } from "../forms/field_form.slint";
import { FieldData } from "../models/field_data.slint";



export component FieldsScreen inherits Rectangle {
    callback go-back();
    callback add-field();
    callback save-field(
        FieldData
    );
    callback edit-field(
        FieldData
    );

    in-out property <int> selected-field-id: -1;
    in-out property <bool> editing-field: false;
    in property <bool> has-fields: false;
    in-out property <bool> show-form: false;
    in property <[FieldData]> fields: [];
    in-out property <FieldData> field;
    // in-out property <string> planting-date: 
    //     "\{root.current-date.year
    //     }-\{root.current-date.month
    //     }-\{root.current-date.day}";
    in-out property <Date> current-date;


    background: transparent;


    VerticalBox {
        padding: 24px;
        spacing: 16px;



        Text {
            text: "Fields";
            font-size: 22px;
            font-weight: 700;
            color: #022817;
        }

        if !root.show-form: UiButton {
            
            label: "+ Add Field";
            clicked => {
                root.editing-field = false;
                root.selected-field-id = -1;
                root.field.id = 0;
                root.field.name = "";
                root.field.area = "";
                root.field.area-unit = "m²";
                root.field.crop = "";
                // root.planting-date = 
                //     "\{root.current-date.year
                //     }-\{root.current-date.month
                //     }-\{root.current-date.day}";
                root.field.planting-date = "2026-10-10";
                root.field.status = "Fallow";
                root.add-field();
            }
        }

        if root.show-form: FieldForm {
            editing: root.editing-field;
            field <=> root.field;
            save-field(
                field
            ) => {
                root.save-field(
                    field
                );
            }

            cancel => {
                root.show-form = false;
            }
        }

        if !root.show-form: Flickable {
            viewport-width: self.width;
            viewport-height: max(
                self.height,
                root.fields.length * 130px
            );

            VerticalBox {
                spacing: 10px;

                if !root.has-fields: VerticalBox {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "Nothing here yet";
                        color: #022817;
                    }

                    Text {
                        text: "Tap + Add Field to register your first field.";
                        color: #59665c;
                        wrap: word-wrap;
                    }
                }

                for field in root.fields: Rectangle {
                    height: 120px;
                    background: #f4fff5;
                    border-radius: 8px;

                    Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text: field.display-text;
                        color: #022817;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    TouchArea {
                clicked => {
                    root.editing-field = true;
                    root.selected-field-id = field.id;
                    root.field = field;
                    root.edit-field(
                        field
                    );
                }
            }
                }
            }
        }


    }
}
