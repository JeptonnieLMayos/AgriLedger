import { VerticalBox, Button, StandardButton, Date, HorizontalBox, ComboBox } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";
import { ScreenState } from "../models/screen_state.slint";
import { UiButtonImg } from "../UI/ui_button_img.slint";
import { ConfirmDialog } from "../UI/confirm_dialog.slint";

import { FarmData } from "../models/farm_data.slint";
import { FarmForm } from "../forms/farm_form.slint";

import { GroupData } from "../models/group_data.slint";
import { GroupForm } from "../forms/group_form.slint";

import { FieldData } from "../models/field_data.slint";
import { FieldForm } from "../forms/field_form.slint";


export component HomeScreen inherits Rectangle {
    
    callback add-farm();
    callback save-farm( FarmData );
    callback edit-farm( FarmData );
    callback delete-farm(int);
    
    callback add-group();
    callback save-group( GroupData );
    callback edit-group( GroupData );
    callback delete-group(int);
        
    callback add-field();
    callback save-field( FieldData );
    callback edit-field( FieldData );
    callback delete-field(int);
    
    in-out property <ScreenState> screen-farm: {
        selected-id: -1,
        is-editing: false,
        show-delete-dialog: false,
        pending-delete-id: -1
    };
        
    in-out property <ScreenState> screen-group: {
        selected-id: -1,
        is-editing: false,
        show-delete-dialog: false,
        pending-delete-id: -1
    };
            
    in-out property <ScreenState> screen-field: {
        selected-id: -1,
        is-editing: false,
        show-delete-dialog: false,
        pending-delete-id: -1
    };
  
    in property <Date> current-date;

    in-out property <bool> farm-has-items: false;
    in-out property <bool> farm-show-form: false;
    in property <[FarmData]> farms: [];
    in-out property <FarmData> farm;
    
    in-out property <bool> group-has-items: false;
    in-out property <bool> group-show-form: false;
    in property <[GroupData]> groups: [];
    in-out property <GroupData> group;
      
    in-out property <bool> field-has-items: false;
    in-out property <bool> field-show-form: false;
    in property <[FieldData]> fields: [];
    in-out property <FieldData> field;
    
    in property <color> dark-color;
    in-out property <int> name;

    in-out property <string> active-page: "farm";


    VerticalLayout {
        padding: 24px;
        spacing: 16px;
    
        if  !root.farm-show-form && 
            !root.group-show-form &&
            !root.field-show-form: ComboBox {
                model: ["farm", "group", "field"];
                current-value <=> root.active-page;
        }

        if !root.farm-show-form && !root.group-show-form && !root.field-show-form: Text {
            text: "Your farm, your records.";
            color: #212923;
            font-size: 15px;
        }


        if  !root.farm-show-form && 
            !root.group-show-form &&
            !root.field-show-form && 
            root.active-page == "farm": Flickable {
            VerticalBox {
                spacing: 10px;
                for farm in root.farms: Rectangle {
                    height: 120px;
                    background: #f4fff5;
                    border-radius: 8px;

                    Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text: farm.display-text;
                        color: #022817;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    HorizontalBox {
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        VerticalBox {
                            alignment: start;
                            UiButtonImg {
                                width: 24px;
                                height: 24px;
                                img-height: 23px;
                                img-width: 23px;
                                colorize: #002000;
                                img: @image-url("../Icons/Pencil/Pencil-Write-2.png");
                                clicked => {
                                    root.screen-farm.is-editing = true;
                                    root.screen-farm.selected-id = farm.id;
                                    root.farm = farm;
                                    root.edit-farm(
                                        farm
                                        );
                                }
                            }

                            UiButtonImg {
                                width: 24px;
                                height: 24px;
                                img-height: 23px;
                                img-width: 23px;
                                colorize: #b00000;
                                img: @image-url("../Icons/Trash/Trash-Bin-Circle.png");
                                clicked => {
                                    root.screen-farm.pending-delete-id = farm.id;
                                    root.screen-farm.show-delete-dialog = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        if  !root.farm-show-form && 
            !root.group-show-form &&
            !root.field-show-form && 
            root.active-page == "group": Flickable {
            VerticalBox {
                spacing: 10px;
                for farm in root.groups: Rectangle {
                    height: 120px;
                    background: #f4fff5;
                    border-radius: 8px;

                    Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text: group.display-text;
                        color: #022817;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    HorizontalBox {
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        VerticalBox {
                            alignment: start;
                            UiButtonImg {
                                width: 24px;
                                height: 24px;
                                img-height: 23px;
                                img-width: 23px;
                                colorize: #002000;
                                img: @image-url("../Icons/Pencil/Pencil-Write-2.png");
                                clicked => {
                                    root.screen-group.is-editing = true;
                                    root.screen-group.selected-id = group.id;
                                    root.group = group;
                                    root.edit-group(
                                        group
                                        );
                                }
                            }

                            UiButtonImg {
                                width: 24px;
                                height: 24px;
                                img-height: 23px;
                                img-width: 23px;
                                colorize: #b00000;
                                img: @image-url("../Icons/Trash/Trash-Bin-Circle.png");
                                clicked => {
                                    root.screen-group.pending-delete-id = group.id;
                                    root.screen-group.show-delete-dialog = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        if  !root.farm-show-form && 
            !root.group-show-form &&
            !root.field-show-form && 
            root.active-page == "field": Flickable {
            VerticalBox {
                spacing: 10px;
                for field in root.fields: Rectangle {
                    height: 120px;
                    background: #f4fff5;
                    border-radius: 8px;

                    Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text: field.display-text;
                        color: #022817;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    HorizontalBox {
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        VerticalBox {
                            alignment: start;
                            UiButtonImg {
                                width: 24px;
                                height: 24px;
                                img-height: 23px;
                                img-width: 23px;
                                colorize: #002000;
                                img: @image-url("../Icons/Pencil/Pencil-Write-2.png");
                                clicked => {
                                    root.screen-field.is-editing = true;
                                    root.screen-field.selected-id = field.id;
                                    root.field = field;
                                    root.edit-field(
                                        field
                                        );
                                }
                            }

                            UiButtonImg {
                                width: 24px;
                                height: 24px;
                                img-height: 23px;
                                img-width: 23px;
                                colorize: #b00000;
                                img: @image-url("../Icons/Trash/Trash-Bin-Circle.png");
                                clicked => {
                                    root.screen-field.pending-delete-id = field.id;
                                    root.screen-field.show-delete-dialog = true;
                                }
                            }
                        }
                    }
                }
            }
        }



        if !root.farm-show-form && !root.group-show-form && !root.field-show-form: UiButton {
            label: "+ Add Farm";
            clicked => {
                root.screen-farm.is-editing= false;
                root.screen-farm.selected-id = -1;
                root.farm.id = 0;

                root.farm.name = "";
                root.farm.description = "";
                root.farm.notes = "";

                root.group-show-form = false;
                root.field-show-form = false;
                root.add-farm();
            }
        }
        if !root.farm-show-form && !root.group-show-form && !root.field-show-form: UiButton {
            label: "+ Add Group";
            clicked => {
                root.screen-group.is-editing= false;
                root.screen-group.selected-id = -1;
                root.group.id = 0;

                root.group.farm-id = root.screen-farm.selected-id;
                root.group.name = "";
                root.group.description = "";
                root.group.notes = "";

                root.farm-show-form = false;
                root.field-show-form = false;
                root.add-group();
            }
        }
        if !root.farm-show-form && !root.group-show-form && !root.field-show-form: UiButton {
            label: "+ Add Field";
            clicked => {
                root.screen-field.is-editing= false;
                root.screen-field.selected-id = -1;
                root.field.id = 0;

                root.field.farm-id = root.screen-farm.selected-id;
                root.field.name = "";
                root.field.farm-id = root.screen-farm.selected-id;
                root.field.group-id = root.screen-field.selected-id;
                root.field.area = 1;
                root.field.notes = "";

                root.farm-show-form = false;
                root.group-show-form = false;
                root.add-field();
            }
        }


        if farm-show-form: FarmForm {
            editing: root.screen-farm.is-editing;
            farm <=> root.farm;
            save-farm(farm) => {
                root.save-farm(farm);
            }

            cancel => {
                root.farm-show-form = false;
            }
        }

        if group-show-form: GroupForm {
            editing: root.screen-group.is-editing;
            group <=> root.group;
            save-group(group) => {
                root.save-group(group);
            }

            cancel => {
                root.group-show-form = false;
            }
        }

        if field-show-form: FieldForm {
            editing: root.screen-field.is-editing;
            field <=> root.field;
            save-field(field) => {
                root.save-field(field);
            }

            cancel => {
                root.field-show-form = false;
            }
        }
    }

    

    if root.screen-farm.show-delete-dialog: ConfirmDialog {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: {x: 320px , y: 180px };

        title: "Delete record?";
        message: "This record will be permanently deleted. This action cannot be undone.";

        cancelled => {
            root.screen-farm.show-delete-dialog = false;
            root.screen-farm.pending-delete-id = -1;
        }

        confirmed => {
            root.delete-farm(root.screen-farm.pending-delete-id);
            root.screen-farm.show-delete-dialog = false;
            root.screen-farm.pending-delete-id = -1;
        }
    }

}