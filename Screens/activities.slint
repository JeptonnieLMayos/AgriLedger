
import { VerticalBox, Date, HorizontalBox } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";
import { ActivityForm } from "../forms/activity_form.slint";
import { ActivityData } from "../models/activity_data.slint";
import { ScreenState } from "../models/screen_state.slint";
import { CropData } from "../models/crop_data.slint";
import { UiButtonImg } from "../UI/ui_button_img.slint";
import { ConfirmDialog } from "../UI/confirm_dialog.slint";

export component ActivitiesScreen inherits Rectangle {
    callback go-back();
    callback add-activity();
    callback save-activity( ActivityData );
    callback edit-activity( ActivityData );
    callback delete-activity( int );

    in property <Date> current-date;
    in-out property <ScreenState> screen: {
        selected-id: -1,
        is-editing: false,
        show-delete-dialog: false,
        pending-delete-id: -1
    };

    in-out property <bool> has-items: false;
    in-out property <bool> show-form: false;
    in property <[ActivityData]> activities: [];
    in-out property <ActivityData> activity;
    in property <[string]> crop-names;

    if !root.show-form: UiButton {
        x: root.width - self.width ;
        y: root.height;
        corner-radius: 50px;
        width: 44px;
        label: "+";
        _font-size: 1.5rem;
        clicked => {
            root.screen.is-editing = false;
            root.screen.selected-id = -1;
            root.activity.id = 0;
            root.activity.category = "Planting";
            root.activity.description = "";
            root.activity.crop-id = 0;
            root.activity.material-id = 0;
            root.activity.scheduled-at = "";
            root.activity.status = "To Do";
            root.activity.started-at = "";
            root.activity.completed-at = "";
            root.activity.notes = "";
            root.activity.created-at =  
                "\{root.current-date.year
                }-\{root.current-date.month
                }-\{root.current-date.day}";
            root.add-activity();
        }
    }
    
   VerticalBox {
        padding: 24px;
        spacing: 16px;
        Text {
            text: "Activities";
            font-size: 18px;
            font-weight: 700;
            color: #022817;
        }

        if root.show-form: ActivityForm {
            editing: root.screen.is-editing;
            activity <=> root.activity;
            crop-names: root.crop-names;
            save-activity(activity) => {
                root.save-activity(activity);
            }

            cancel => {
                root.show-form = false;
            }
        }

        if !root.show-form: VerticalBox {

            HorizontalLayout {
                spacing: 2px;
                UiButton {
                    label: "All";
                }
                UiButton {
                    label: "Upcomming";
                }
                UiButton {
                    label: "Completed";
                }
            }
            if !show-form: Flickable {
                VerticalBox {
                    if !root.has-items: VerticalBox {
                        Rectangle {
                            border-radius: 8px;
                            border-color: darkgreen;
                            border-width: 1px;
                            VerticalLayout {
                
                                Text {
                                    text: "Planting, weeding, watering, fertilizing, Pruning, Watering, Fertilizing, Land preparation, Harvesting.";
                                }
                                
                            }
                        }
                    }

                    for activity in root.activities: Rectangle {
                        height: 120px;
                        background: #f4fff5;
                        border-radius: 8px;
                        Text {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            height: parent.height - 20px;
                            text: activity.display-text;
                            color: #022817;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                        
                        HorizontalBox {
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            VerticalBox {
                                alignment: start;
                                UiButtonImg {
                                    width: 24px;
                                    height: 24px;
                                    img-height: 23px;
                                    img-width: 23px;
                                    colorize: #002000;
                                    img: @image-url("../Icons/Pencil/Pencil-Write-2.png");
                                    clicked => {
                                        root.screen.is-editing = true;
                                        root.screen.selected-id = activity.id;
                                        root.activity = activity;
                                        root.edit-activity(
                                            activity
                                            );
                                    }
                                }
    
                                UiButtonImg {
                                    width: 24px;
                                    height: 24px;
                                    img-height: 23px;
                                    img-width: 23px;
                                    colorize: #b00000;
                                    img: @image-url("../Icons/Trash/Trash-Bin-Circle.png");
                                    clicked => {
                                        root.screen.pending-delete-id = activity.id;
                                        root.screen.show-delete-dialog = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.screen.show-delete-dialog: ConfirmDialog {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: {x: 320px , y: 180px };

        title: "Delete record?";
        message: "This record will be permanently deleted. This action cannot be undone.";

        cancelled => {
            root.screen.show-delete-dialog = false;
            root.screen.pending-delete-id = -1;
        }

        confirmed => {
            root.delete-activity(root.screen.pending-delete-id);
            root.screen.show-delete-dialog = false;
            root.screen.pending-delete-id = -1;
        }
    }
}

