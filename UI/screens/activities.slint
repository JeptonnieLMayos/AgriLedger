
import { VerticalBox, Date, HorizontalBox } from "std-widgets.slint";
import { UiButton } from "../components/ui_button.slint";
import { ActivityForm } from "../forms/activity_form.slint";
import { ActivityData } from "../models/activity_data.slint";
import { ScreenState } from "../models/screen_state.slint";
import { CropData } from "../models/crop_data.slint";
import { UiButtonImg } from "../components/ui_button_img.slint";
import { ConfirmDialog } from "../components/confirm_dialog.slint";
import { RecordCard } from "../components/record_card.slint";
import { RecordDeleteDialog } from "../components/record_delete_dialog.slint";

export component ActivitiesScreen inherits Rectangle {
    callback go-back();
    callback add-activity();
    callback save-activity( ActivityData );
    callback edit-activity( ActivityData );
    callback delete-activity( int );

    in-out property <string> current-page;
    in property <Date> current-date;
    in-out property <ScreenState> screen: {
        selected-id: -1,
        is-editing: false,
        show-delete-dialog: false,
        pending-delete-id: -1
    };

    in-out property <bool> has-items: false;
    in property <[ActivityData]> activities: [];
    in-out property <ActivityData> activity;
    in property <[string]> crop-names;

    if current-page == "activities": UiButton {
        x: root.width - self.width ;
        y: root.height;
        corner-radius: 50px;
        width: 44px;
        label: "+";
        _font-size: 1.5rem;
        clicked => {
            root.screen.is-editing = false;
            root.screen.selected-id = -1;
            root.activity.id = 0;
            root.activity.category = "Planting";
            root.activity.description = "";
            root.activity.crop-id = 0;
            root.activity.material-id = 0;
            root.activity.scheduled-at = "";
            root.activity.status = "To Do";
            root.activity.started-at = "";
            root.activity.completed-at = "";
            root.activity.notes = "";
            root.activity.created-at =  
                "\{root.current-date.year
                }-\{root.current-date.month
                }-\{root.current-date.day}";
            root.add-activity();
        }
    }
    
   VerticalBox {
        padding: 24px;
        spacing: 16px;
        Text {
            text: "Activities";
            font-size: 18px;
            font-weight: 700;
            color: #022817;
        }

        if current-page == "form": ActivityForm {
            editing: root.screen.is-editing;
            activity <=> root.activity;
            crop-names: root.crop-names;
            save-activity(activity) => {
                root.save-activity(activity);
            }

            cancel => {
                current-page == "overview";
            }
        }

        if current-page == "activities": VerticalBox {

            HorizontalLayout {
                spacing: 2px;
                UiButton {
                    label: "All";
                }
                UiButton {
                    label: "Upcomming";
                }
                UiButton {
                    label: "Completed";
                }
            }
            if current-page == "activities": Flickable {
                VerticalBox {
                    if !root.has-items: VerticalBox {
                        Rectangle {
                            border-radius: 8px;
                            border-color: darkgreen;
                            border-width: 1px;
                            VerticalLayout {
                
                                Text {
                                    text: "Planting, weeding, watering, fertilizing, Pruning, Watering, Fertilizing, Land preparation, Harvesting.";
                                }
                                
                            }
                        }
                    }
                    for activity in root.activities: RecordCard {
                        display-text: activity.display-text;

                        opened => {
                            root.screen.selected-id = activity.id;
                            root.activity = activity;
                            root.current-page = "activity-overview";
                        }
                    }
                }
            }
        }
    }
    if root.screen.show-delete-dialog: RecordDeleteDialog {
        cancelled => {
            root.screen.show-delete-dialog = false;
            root.screen.pending-delete-id = -1;
        }

        confirmed => {
            root.delete-activity(root.screen.pending-delete-id);
            root.screen.show-delete-dialog = false;
            root.screen.pending-delete-id = -1;
        }
    }
}

