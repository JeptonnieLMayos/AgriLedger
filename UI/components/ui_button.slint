export component UiButton inherits Rectangle {
    in property <string> label: "";
    in property <color> button-color: #285943;
    in property <color> text-color: white;
    in property <length> button-height: 44px;
    in property <length> corner-radius: 8px;
    in property <TextHorizontalAlignment> label-horizontal-alignment: center;
    in property <TextVerticalAlignment> label-vertical-alignment: center;

    in property <length> _font-size: 0rem;


    callback clicked();

    background: button-color;
    border-radius: corner-radius;
    height: button-height;

    Text {
        text: label;
        color: text-color;
        horizontal-alignment: label-horizontal-alignment;
        vertical-alignment: label-vertical-alignment;
        font-size: _font-size;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

