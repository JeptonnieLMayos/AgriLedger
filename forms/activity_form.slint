import { VerticalBox, Date, ComboBox } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";
import { UILineEdit } from "../UI/ui_line_edit.slint";
import { UIComboBox } from "../UI/ui_combo_box.slint";
import { UIDatePicker } from "../UI/ui_date_picker.slint";
import { ActivityData } from "../models/activity_data.slint";
import { ActivityMaterialData } from "../models/activity_material_data.slint";
import { CropData } from "../models/crop_data.slint";

export component ActivityForm inherits VerticalBox {
    callback save-activity(
        ActivityData
    );
    callback cancel();
    
    spacing: 10px;

    in property <Date> current-date;
    in property <bool> editing: false;
    in-out property <ActivityData> activity;
    in property <[string]> crop-names;
    in-out property <ActivityMaterialData> materials; 


    Text {
        text: root.editing ? "Edit" : "New";
        font-size: 18px;
        font-weight: 700;
        color: #022817;
    }

    Text {
        text: "Category";
        color: #022817;
    }


    UILineEdit {
        _text <=> root.activity.category;
    }



    Text {
        text: "Description";
        color: #022817;
    }


    UILineEdit {
        _text <=> root.activity.description;
    }

    Text {
        text: "Crop Name";
        color: #022817;
    }

    UIComboBox {
        _model: crop-names;
        _current-value: crop-names[root.activity.crop-id];
        _current-index <=> root.activity.crop-id;

    }

    Text {
        text: "Scheduled";
        color: #022817;
    }

    UIDatePicker {
        date_string <=> root.activity.scheduled-at;
    }

    Text {
        text: "Status";
        color: #022817;
    }

    UIComboBox {
        _model: [ "To Do", "Scheduled", "On-Going", "Stalled", "Almost Done", " Completed"];
        _current-value: root.activity.status;
    }

    Text {
        text: "Started At";
        color: #022817;
    }

    UIDatePicker {
        date_string <=> root.activity.started-at;
    }

    Text {
        text: "Completed At";
        color: #022817;
    }

    UIDatePicker {
        date_string <=> root.activity.started-at;
    }

    Text {
    text: "notes";
    color: #022817;
    }

    UILineEdit {
        _text <=> root.activity.notes;
    }

    UiButton {
        label: root.editing ? "Save Changes" : "Save";
        clicked => {
            save-activity(root.activity)
        }
    }

    UiButton {
        label: "Cancel";
        button-color: #59665c;
        clicked => {
            root.cancel();
        }
    }
}