import { VerticalBox, Date, TextEdit, HorizontalBox } from "std-widgets.slint";
import { UiButton } from "../components/ui_button.slint";
import { UILineEdit } from "../components/ui_line_edit.slint";
import { UIComboBox } from "../components/ui_combo_box.slint";
import { UIDatePicker } from "../components/ui_date_picker.slint";
import { FarmData } from "../models/farm_data.slint";
import { UITextEdit } from "../components/ui_text_edit.slint";
import { UiButtonImg } from "../components/ui_button_img.slint";
import { RecordMenu } from "../components/record_menu.slint";
import { ScreenState } from "../models/screen_state.slint";
import { GroupData } from "../models/group_data.slint";
import { FieldData } from "../models/field_data.slint";
import { GroupWithFields } from "../models/group_with_fields.slint";
import { ConfirmDialog } from "../components/confirm_dialog.slint";

export component FarmOverview inherits VerticalBox {
    callback go-back();
    callback edit-farm(FarmData);
    callback delete-farm(int);

    callback add-group();
    callback edit-group(GroupData);
    callback delete-group(int);

    callback add-field();
    callback edit-field(FieldData);
    callback delete-field(int);

    in-out property <FarmData> farm;
    in-out property <GroupData> group;
    in-out property <FieldData> field;
    in property <[GroupWithFields]> groups-with-fields;
    in property <color> dark-color;
    in-out property <string> record-menu-target: "";
    in-out property <ScreenState> screen;

    Rectangle {
        background: #f4fff5;
        border-radius: 12px;

        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            HorizontalBox {
                padding: 0px;
                Text {
                    text: farm.name;
                    color: black;
                    font-weight: 800;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                Rectangle {
                    Text {
                        text: "...";
                        color: dark-color;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    TouchArea {
                        clicked => {
                            record-menu-target = "farm";
                            record-menu.show();
                        }
                    }
                }
            }

            Rectangle {
                background: lightgray;
                height: 1px;
            }
            if farm.description != "": Text {
                text: farm.description;
                color: gray;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
            if farm.notes != "": Text {
                text: farm.notes;
                color: gray;
                font-italic: true;
                font-size: 12px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if farm.description == "": Rectangle {
                height: 1px;
            }
            if farm.notes == "": Rectangle {
                height: 1px;
            }
        }
    }

    Rectangle {
        border-radius: 12px;
        border-width: 2px;
        border-color: dark-color;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: "Groups";
                color: black;
                font-weight: 600;
            }
            
            
            Flickable {
                VerticalLayout {
                    spacing: 8px;
                    for group-with-field in groups-with-fields: Rectangle {
                        background: #f4fff5;
                        border-radius: 12px;
                        VerticalBox {
                            padding: 8px;
                            HorizontalBox {
                                padding: 5px;
                                Image {
                                    source: @image-url("../../Icons/Folder/Folder.png");
                                    image-fit: contain;
                                    width: 16px;
                                    height: 16px;
                                }
                                Text {
                                    text: group-with-field.group.name;
                                    color: black;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                }
                                Rectangle {
                                    Text {
                                        text: "...";
                                        color: dark-color;
                                        font-size: 16px;
                                        font-weight: 700;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.group = group-with-field.group;
                                            record-menu-target = "group";
                                            record-menu.show();
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: lightgray;
                            }
        
                            
        
                            for field in group-with-field.fields : Rectangle {
                                VerticalBox {
                                    padding: 8px;
                                    HorizontalBox {
                                        padding: 5px;
                                        Image {
                                            source: @image-url("../../Icons/L/Plant-Mint-Minting.png");
                                            image-fit: contain;
                                            width: 16px;
                                            height: 16px;
                                        }
                                        Text {
                                            text: field.name;
                                            color: black;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                        Rectangle {
                                            Text {
                                                text: "...";
                                                color: dark-color;
                                                font-size: 16px;
                                                font-weight: 700;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.field = field;
                                                    record-menu-target = "field";
                                                    record-menu.show();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                border-radius: 12px;
                                background: #ddeadd;
                                height: 32px;
        
                                HorizontalBox {
                                    alignment: center;
                                    padding: 8px;
        
                                        Text {
                                            text: "+";
                                            color: dark-color;
                                            font-weight: 550;
                                        }
                                    Text {
                                        text: "Add field";
                                        color: dark-color;
                                        font-weight: 550;
                                    }
                                }
        
                                TouchArea {
                                    clicked => {
                                        root.group = group-with-field.group;
                                        add-field();
                                    };
                                    
                                }
                            }
                            
        
                        }
        
                    }
                }
            }

            Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: dark-color;
                height: 44px;

                HorizontalBox {
                    alignment: center;
                    padding: 14px;
                    Rectangle {
                        border-color: dark-color;
                        border-width: 2px;
                        border-radius: 50px;
                        width: 15px;
                        height: 15px;
                        
                        Text {
                            text: "+";
                            color: dark-color;
                            font-weight: 550;
                        }
                    }
                    Text {
                        text: "Add Group";
                        color: dark-color;
                        font-weight: 550;
                    }
                }

                TouchArea {
                    clicked => {
                        add-group();
                    };
                    
                }
            }
            
        }
    }
    delete-dialog:= ConfirmDialog {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        name:   record-menu-target == "farm" ? farm.name :
                record-menu-target == "group" ? group.name :
                record-menu-target == "field" ? field.name :
                "";
        title: record-menu-target + " > " + self.name;

        cancelled => {
            root.screen.pending-delete-id = -1;
        }

        confirmed => {
            if record-menu-target == "farm" { root.delete-farm(root.screen.pending-delete-id); }
            if record-menu-target == "group" { root.delete-group(root.screen.pending-delete-id); }
            if record-menu-target == "field" { root.delete-field(root.screen.pending-delete-id); }
            debug(screen.pending-delete-id + " " + record-menu-target);

            root.screen.pending-delete-id = -1;
        }
    }
  
    record-menu := RecordMenu{
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        header: record-menu-target == "farm" ? record-menu-target + " > " + farm.name :
                record-menu-target == "group" ? record-menu-target + " > " + group.name :
                record-menu-target == "field" ? record-menu-target + " > " + field.name :
                "";

        x-clicked => {
            record-menu-target = "";
        }
        edit-clicked() => {
            if record-menu-target == "farm" { edit-farm(farm); }
            if record-menu-target == "group" { edit-group(group); }
            if record-menu-target == "field" { edit-field(field); }
        }
        delete-clicked => {
            if record-menu-target == "farm" { root.screen.pending-delete-id = farm.id; }
            if record-menu-target == "group" { root.screen.pending-delete-id = group.id; }
            if record-menu-target == "field" { root.screen.pending-delete-id = field.id; }
            delete-dialog.show();
        }
    }
}
 