import { VerticalBox, Date, TextEdit } from "std-widgets.slint";
import { UiButton } from "../components/ui_button.slint";
import { UILineEdit } from "../components/ui_line_edit.slint";
import { UIComboBox } from "../components/ui_combo_box.slint";
import { UIDatePicker } from "../components/ui_date_picker.slint";
import { FieldData } from "../models/field_data.slint";
import { UITextEdit } from "../components/ui_text_edit.slint";

export component FieldForm inherits VerticalBox {
    callback save-field(
        FieldData
    );
    callback cancel();
    
    spacing: 10px;

    in property <Date> current-date;
    in property <bool> editing: false;
    in-out property <FieldData> field; 


    Text {
        text: root.editing ? "Edit" : "New";
        font-size: 18px;
        font-weight: 700;
        color: #022817;
    }

    Text {
        text: "Name";
        color: #022817;
    }


    UILineEdit {
        _text <=> root.field.name;
    }



    Text {
        text: "Area";
        color: #022817;
    }


    UILineEdit {
        // _text <=> root.field.area;
    }

    Text {
        text: "notes:";
        color: #022817;
    }

    UILineEdit {
        _text <=> root.field.notes;
    }

    UiButton {
        label: root.editing ? "Save Changes" : "Save";
        clicked => {
            if root.field.name == "" {
                return;
            }
            root.save-field(
                field
            );
        }
    }

    UiButton {
        label: "Cancel";
        button-color: #59665c;
        clicked => {
            root.cancel();
        }
    }
}