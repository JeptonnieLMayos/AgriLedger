
import { VerticalBox, LineEdit, ComboBox } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";

export component FieldsScreen inherits Rectangle {
    callback go-back();
    callback add-field();
    callback save-field(
        string,
        string,
        string,
        string,
        string,
        string
    );

    in property <bool> has-fields: false;
    in-out property <bool> show-form: false;
    in property <[string]> field-lines: [];

    in-out property <string> field-name: "";
    in-out property <string> field-area: "";
    in-out property <string> area-unit: "m²";
    in-out property <string> crop: "";
    in-out property <string> planting-date: "";
    in-out property <string> status: "Fallow";

    background: transparent;

    VerticalBox {
        padding: 24px;
        spacing: 16px;
/*  */
        Text {
            text: "Fields";
            font-size: 22px;
            font-weight: 700;
            color: #022817;
        }

        if !root.show-form: UiButton {
            label: "+ Add Field";
            clicked => {
                root.field-name = "";
                root.field-area = "";
                root.area-unit = "m²";
                root.crop = "";
                root.planting-date = "";
                root.status = "Fallow";
                root.add-field();
            }
        }

        if root.show-form: VerticalBox {
            spacing: 10px;

            Text {
                text: "New Field";
                font-size: 18px;
                font-weight: 700;
                color: #022817;
            }

            Text {
                text: "Field name or number";
                color: #022817;
            }

            LineEdit {
                text <=> root.field-name;
            }

            Text {
                text: "Area";
                color: #022817;
            }

            LineEdit {
                text <=> root.field-area;
            }

            Text {
                text: "Measurement unit";
                color: #022817;
            }

            ComboBox {
                model: ["m²", "hectares", "acres"];
                current-value <=> root.area-unit;
            }

            Text {
                text: "Current crop";
                color: #022817;
            }

            LineEdit {
                text <=> root.crop;
            }

            Text {
                text: "Planting date (YYYY-MM-DD)";
                color: #022817;
            }

            LineEdit {
                text <=> root.planting-date;
            }

            Text {
                text: "Field status";
                color: #022817;
            }

            ComboBox {
                model: ["Growing", "Harvested", "Fallow", "Prepared"];
                current-value <=> root.status;
            }

            UiButton {
                label: "Save Field";
                clicked => {
                    if root.field-name != "" &&
                       root.field-area != "" {
                        root.save-field(
                            root.field-name,
                            root.field-area,
                            root.area-unit,
                            root.crop,
                            root.planting-date,
                            root.status
                        );
                    }
                }
            }

            UiButton {
                label: "Cancel";
                button-color: #59665c;
                clicked => {
                    root.show-form = false;
                }
            }
        }

        if !root.show-form: Flickable {
            // width: parent.width;
            // height: 400px;

            viewport-width: self.width;
            viewport-height: max(
                self.height,
                root.field-lines.length * 130px
            );

            VerticalBox {
                // width: parent.width;
                spacing: 10px;

                if !root.has-fields: VerticalBox {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "Nothing here yet";
                        color: #022817;
                    }

                    Text {
                        text: "Tap + Add Field to register your first field.";
                        color: #59665c;
                        wrap: word-wrap;
                    }
                }

                for field in root.field-lines: Rectangle {
                    // width: parent.width;
                    height: 120px;
                    background: #f4fff5;
                    border-radius: 8px;

                    Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text: field;
                        color: #022817;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }


    }
}
