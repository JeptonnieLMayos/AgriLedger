import { VerticalBox, Date, TextEdit, HorizontalBox } from "std-widgets.slint";
import { UiButton } from "../components/ui_button.slint";
import { UILineEdit } from "../components/ui_line_edit.slint";
import { UIComboBox } from "../components/ui_combo_box.slint";
import { UIDatePicker } from "../components/ui_date_picker.slint";
import { FarmData } from "../models/farm_data.slint";
import { UITextEdit } from "../components/ui_text_edit.slint";

export component FarmOverview inherits VerticalBox {
    callback go-back();

    in-out property <FarmData> farm;

    Rectangle {
        background: #f4fff5;
        border-radius: 12px;
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            HorizontalBox {
                padding: 0px;
                Text {
                    text: farm.name;
                    color: black;
                    font-weight: 800;
                    font-size: 14px;
                    horizontal-alignment: start;
                    vertical-alignment: center;
                }
                VerticalBox {
                    spacing: 0px;
                    padding: 0px;
                    Image {
                        source: @image-url("../../Icons/Menu/Navigation-Menu-Horizontal-1.png");
                        colorize: #285943;
                    }
                }
            }
            if farm.description != "": Text {
                text: farm.description;
                color: gray;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: start;
                wrap: word-wrap;
                overflow: elide;
            }
            if farm.notes != "": Text {
                text: farm.notes;
                color: gray;
                font-italic: true;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: start;
                wrap: word-wrap;
            }

        }
    }


}