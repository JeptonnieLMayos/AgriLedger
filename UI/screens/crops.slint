
import { VerticalBox, LineEdit, ComboBox, Date, Button, HorizontalBox } from "std-widgets.slint";
import { UiButton } from "../components/ui_button.slint";
import { UILineEdit } from "../components/ui_line_edit.slint";
import { UIComboBox } from "../components/ui_combo_box.slint";
import { UIDatePicker } from "../components/ui_date_picker.slint";
import { CropForm } from "../forms/crop_form.slint";
import { CropData } from "../models/crop_data.slint";
import { ConfirmDialog } from "../components/confirm_dialog.slint";
import { UiButtonImg } from "../components/ui_button_img.slint";
import { ScreenState } from "../models/screen_state.slint";
import { RecordCard } from "../components/record_card.slint";
import { CropOverview } from "../overviews/crop_overview.slint";



export component CropsScreen inherits Rectangle {
    callback go-back();
    callback add-crop();
    callback save-crop( CropData );
    callback edit-crop( CropData );
    callback delete-crop(int);

    in-out property <string> current-page: "crops";
    in property <Date> current-date;
    in-out property <ScreenState> screen: {
        selected-id: -1,
        is-editing: false,
        show-delete-dialog: false,
        pending-delete-id: -1
    };

    in-out property <bool> has-items: false;
    in property <[CropData]> crops: [];
    in-out property <CropData> crop;

    in property <int> farm_id;
    in-out property <string> empty-text:
        farm_id < 0 ? "Select farm first." :
        "Tap + to register your first crop.";
    in-out property <string> header: "Crops";

    in property <color> dark-color;
    in-out property <string> head-text: header;

    out property <CropData> new: {
        id: 0,
        name: "",
        area: 1,
        farm-id: root.farm_id,
        field_id: -1,
        planting-date:
                "\{root.current-date.year
                }-\{root.current-date.month
                }-\{root.current-date.day}",
        status: "Fallow"
    };

    if current-page == "crops": UiButton {
        x: root.width - self.width;
        y: root.height;
        corner-radius: 50px;
        width: 44px;
        label: "+";
        _font-size: 1.5rem;
        clicked => {
            root.screen.is-editing = false;
            root.screen.selected-id = -1;
            root.crop = new;
            root.add-crop();
        }
    }

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        HorizontalLayout {
            Rectangle {
                height: 32px;
                width: 44px;
                if root.current-page != "crops" : UiButtonImg {
                    img: @image-url("../../Icons/Arrows/Arrow-Circle-Left-Fill.png");
                    img-height: 32px;
                    img-width: 32px;
                    colorize: dark-color;
                    clicked => {
                        current-page =  current-page == "overview" ? "crops" :
                                        current-page == "form" && screen.is-editing ? "overview" :
                                        current-page == "form" && !screen.is-editing ? "crops" :
                                        "crops";
                    }
                }
            } 

            Text {
                text: head-text;
                font-size: 22px;
                font-weight: 700;
                color: #022817;
            }
        }

        if current-page == "form": CropForm {
            editing: root.screen.is-editing;
            crop <=> root.crop;
            save-crop(crop) => {
                root.save-crop(crop);
            }

            cancel => {
                current-page =
                root.screen.is-editing?
                "overview" : 
                "crops";
            }
        }

        if current-page == "crops": Flickable {
            VerticalBox {
                spacing: 10px;

                if !root.has-items: VerticalBox {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "Nothing here yet";
                        color: #022817;
                    }

                    Text {
                        text: empty-text;
                        color: #59665c;
                        wrap: word-wrap;
                    }
                }

                for crop in root.crops: RecordCard {
                    display-text: crop.name;

                    opened => {
                        root.screen.selected-id = crop.id;
                        root.crop = crop;
                        root.current-page = "overview";
                    }
                }
            }
        }

        if current-page == "overview": CropOverview {
            go-back => {
                root.screen.selected-id = -1;
                root.crop = new;
            }
            edit-crop => {edit-crop(crop);}
            delete-crop => {
                delete-crop(screen.pending-delete-id);
                current-page = "crops";
            }

            crop <=> root.crop;
            dark-color: root.dark-color;
            screen <=> root.screen;
        }
    }

}
