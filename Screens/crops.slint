
import { VerticalBox, LineEdit, ComboBox, Date, Button, HorizontalBox } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";
import { UILineEdit } from "../UI/ui_line_edit.slint";
import { UIComboBox } from "../UI/ui_combo_box.slint";
import { UIDatePicker } from "../UI/ui_date_picker.slint";
import { CropForm } from "../forms/crop_form.slint";
import { CropData } from "../models/crop_data.slint";
import { ConfirmDialog } from "../UI/confirm_dialog.slint";
import { UiButtonImg } from "../UI/ui_button_img.slint";



export component CropsScreen inherits Rectangle {
    callback go-back();
    callback add-crop();
    callback save-crop(
        CropData
    );
    callback edit-crop(
        CropData
    );
    callback delete-crop(int);

    in-out property <int> selected-crop-id: -1;
    in-out property <bool> editing-crop: false;
    in property <bool> has-crops: false;
    in-out property <bool> show-form: false;
    in property <[CropData]> crops: [];
    in-out property <CropData> crop;
    in-out property <Date> current-date;
    in-out property <bool> show-delete-dialog: false;
    in-out property <int> pending-delete-id: -1;



    background: transparent;

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "Crops";
            font-size: 22px;
            font-weight: 700;
            color: #022817;
        }



        if !root.show-form: UiButton {
            
            label: "+ Add Crop";
            clicked => {
                root.editing-crop = false;
                root.selected-crop-id = -1;
                root.crop.id = 0;
                root.crop.name = "";
                root.crop.area = "";
                root.crop.area-unit = "m²";
                root.crop.crop = "";
                root.crop.planting-date = 
                    "\{root.current-date.year
                    }-\{root.current-date.month
                    }-\{root.current-date.day}";
                root.crop.status = "Fallow";
                root.add-crop();
            }
        }

        if root.show-form: CropForm {
            editing: root.editing-crop;
            crop <=> root.crop;
            save-crop(
                crop
            ) => {
                root.save-crop(
                    crop
                );
            }

            cancel => {
                root.show-form = false;
            }
        }

        if !root.show-form: Flickable {
            viewport-width: self.width;
            viewport-height: max(
                self.height,
                root.crops.length * 130px
            );

            VerticalBox {
                spacing: 10px;

                if !root.has-crops: VerticalBox {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "Nothing here yet";
                        color: #022817;
                    }

                    Text {
                        text: "Tap + Add Crop to register your first crop.";
                        color: #59665c;
                        wrap: word-wrap;
                    }
                }

                for crop in root.crops: Rectangle {
                    height: 120px;
                    background: #f4fff5;
                    border-radius: 8px;

                    Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text: crop.display-text;
                        color: #022817;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    HorizontalBox {
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        VerticalBox {
                            alignment: start;
                            UiButtonImg {
                                width: 24px;
                                height: 24px;
                                img-height: 23px;
                                img-width: 23px;
                                colorize: #002000;
                                img: @image-url("../Icons/Pencil/Pencil-Write-2.png");
                                clicked => {
                                    root.editing-crop = true;
                                    root.selected-crop-id = crop.id;
                                    root.crop = crop;
                                    root.edit-crop(
                                        crop
                                        );
                                }
                            }

                            UiButtonImg {
                                width: 24px;
                                height: 24px;
                                img-height: 23px;
                                img-width: 23px;
                                colorize: #b00000;
                                img: @image-url("../Icons/Trash/Trash-Bin-Circle.png");
                                clicked => {
                                    root.pending-delete-id = crop.id;
                                    root.show-delete-dialog = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-delete-dialog: ConfirmDialog {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: {x: 320px , y: 180px };

        title: "Delete record?";
        message: "This record will be permanently deleted. This action cannot be undone.";

        cancelled => {
            root.show-delete-dialog = false;
            root.pending-delete-id = -1;
        }

        confirmed => {
            root.delete-crop(root.pending-delete-id);
            root.show-delete-dialog = false;
            root.pending-delete-id = -1;
        }
    }
}
