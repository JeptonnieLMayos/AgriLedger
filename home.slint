
import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";
import { UiButton } from "UI/ui_button.slint";
import { FieldsScreen } from "Screens/fields.slint";
import { ActivitiesScreen } from "Screens/activities.slint";
import { HarvestScreen } from "Screens/harvest.slint";


export component MainWindow inherits Window {
    title: "AgriLedger";
    preferred-width: 420px;
    preferred-height: 600px;
    background: #afecba;
    in-out property <string> current-screen: "home";

    VerticalBox {
        padding: 24px;
        padding-top: 32px;
        spacing: 16px;
        
        Rectangle {
            border-radius: 50px;
            background: white;
            border-width: 2px;
            border-color: darkgreen;
            

            HorizontalBox {
                alignment: start;
                padding: 10px;
                spacing: 0px;
    
                Image {
                    preferred-width: 40px;
                    preferred-height: 40px;
                    source: @image-url("Images/fruit_veggie.png");
                }
        
                Text {
                    text: "AgriLedger";
                    font-size: 18px;
                    font-weight: 700;
                    color: #022817;
                }
    
            }
        }

        Text {
            text: "Your farm, your records.";
            color: #212923;
            font-size: 15px;
        }

        
        Rectangle {
            background: white;
            border-radius: 12px;
            min-height: 100px;
            
            VerticalBox {
                spacing: 8px;
                
                Text {
                    text: "My Farm";
                    color: black;
                    font-size: 18px;
                    font-weight: 600;
                }
                
                Text {
                    text: "Keep your fields and activities organized.";
                    color: #59665c;
                    wrap: word-wrap;
                }
            }
        }
        
        
if root.current-screen == "home": VerticalBox {
    spacing: 16px;


    UiButton {
        label: "Fields";
        clicked => {
            root.current-screen = "fields";
        }
    }

    UiButton {
        label: "Activities";
        clicked => {
            root.current-screen = "activities";
        }
    }

    UiButton {
        label: "Harvest";
        clicked => {
            root.current-screen = "harvest";
        }
    }
}

if root.current-screen == "fields": FieldsScreen {
    go-back => {
        root.current-screen = "home";
    }
}

if root.current-screen == "activities": ActivitiesScreen {
    go-back => {
        root.current-screen = "home";
    }
}

if root.current-screen == "harvest": HarvestScreen {
    go-back => {
        root.current-screen = "home";
    }
}


        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }

        Text {
            text: "Works offline · Your records stay on your device";
            color: #59665c;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
