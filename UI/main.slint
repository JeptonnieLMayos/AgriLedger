import { CropsScreen } from "screens/crops.slint";
import { ReportsScreen } from "screens/reports.slint";
import { VerticalBox, HorizontalBox, Date, Button } from "std-widgets.slint";
import { UiButtonImg } from "components/ui_button_img.slint";
import { FarmData } from "models/farm_data.slint";
import { GroupData } from "models/group_data.slint";
import { FieldData } from "models/field_data.slint";
import { CropData } from "models/crop_data.slint";
import { ActivitiesScreen } from "screens/activities.slint";
import { HarvestScreen } from "screens/harvest.slint";
import { ScreenState } from "models/screen_state.slint";
import { ActivityData } from "models/activity_data.slint";
import { FarmScreen } from "screens/farm.slint";

component ActiveTabIndicator inherits Rectangle {
    in property <length> _height: 3px;
    in property <color> _background: #15462d;
    in property <bool> active;
    background:  active ? _background : transparent;
    height: _height;
}

export component MainWindow inherits Window {
    title: "AgriLedger";
    preferred-width: 420px;
    preferred-height: 600px;
    background: #c2cbbd;
    


    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        source: @image-url("../Images/cartoon_leaf_background_small.png");
        opacity: 0.35;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
    }

    out property <color> dark-color: #285943;

    in-out property <string> current-screen: "farm";
    in-out property <int> selected-id: -1;

    in-out property <int> active-farm: -1;
    in property <int> active-group: -1;

    in-out property <bool> has-farms: false;
    in-out property <string> farm-current-page: "overview";
    in property <[FarmData]> farms: [];
    in property <[string]> farm-names;
    in-out property <FarmData> farm;
    callback save-farm(FarmData);
    callback delete-farm(int);

    in-out property <bool> has-groups: false;
    in-out property <string> group-current-page: "groups";
    in property <[GroupData]> groups: [];
    in property <[string]> group-names;
    in-out property <GroupData> group;
    callback save-group(GroupData);
    callback delete-group(int);

    in-out property <bool> has-fields: false;
    in-out property <string> field-current-page: "fields";
    in property <[FieldData]> fields: [];
    in property <[string]> field-names;
    in-out property <FieldData> field;
    callback save-field(FieldData);
    callback delete-field(int);

    in-out property <bool> has-crops: false;
    in-out property <string> crop-current-page: "crops";
    in property <[CropData]> crops: [];
    in property <[string]> crop-names;
    in-out property <CropData> crop;
    callback save-crop(CropData);
    callback delete-crop(int);
    
    in-out property <bool> has-activities: false;
    in-out property <string> activities-current-page: "activities";
    in property <[ActivityData]> activities: [];
    in-out property <ActivityData> activity;
    callback save-activity(ActivityData);
    callback delete-activity(int);
    
    in-out property <Date> current-date;
    
    VerticalBox {
        padding: 0px;

        Rectangle {
            background: black;
            drop-shadow-blur: 5px;
            drop-shadow-color: gray;
            drop-shadow-offset-y: 1px;
            VerticalLayout {
                
                padding: 0px;
                Rectangle {
                    background: transparent;
                    height: 32px;
                }
    
                Rectangle {
                background: #cdd6c9;
                height: 56px;
                border-top-left-radius: 16px;
                border-top-right-radius: 16px;
        
                HorizontalBox {
                    padding: 16px;
                    alignment: space-between;
                    spacing: 16px;
        
        
                    
                    HorizontalBox {
                        padding: 0px;
                        spacing: 0px;
                        alignment: start;
                        Image {
                            source: @image-url("../Icons/L/Potted-Tree-2.png");
                            // source: @image-url("../Images/leaf_pair.png");
                            colorize: #15462d;
                            height: 32px;
                            width: 32px;
                            image-fit: contain;
                            }
                        VerticalBox {
                            padding: 0px;
                            spacing: 0px;
                            alignment: start;
                            Text {
                                text: "  AgriLedger";
                                color: #002208;
                                font-size: 16px;
                                font-weight: 800;
                                horizontal-alignment: left;
                                vertical-alignment: bottom;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "    Developed by KumaDeV";
                                color: #002208;
                                font-size: 7.5px;
                                font-weight: 800;
                                horizontal-alignment: left;
                                vertical-alignment: bottom;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Independent software project";
                                color: #002208;
                                font-size: 7.5px;
                                font-weight: 800;
                                horizontal-alignment: left;
                                vertical-alignment: bottom;
                                wrap: word-wrap;
                            }
                        }
                    }
        
                    Rectangle {
                        background: transparent;
                        horizontal-stretch: 1;
                        Text {
                            font-weight: 600;
                            text: current-date.year + "-" + current-date.month + "-" + current-date.day;
                        }
                    }
        
                    Image {
                        colorize: #15462d;
                        source: @image-url("../Icons/Cog/Cog-1.png");
                        height: 32px;
                        width: 32px;
                        image-fit: contain;
                        }
        
        
                }
            }
            }


        }

    VerticalBox {
        padding: 24px;
        padding-top: 32px;
        spacing: 16px;
        alignment: start;

        if root.current-screen == "farm": FarmScreen {
            dark-color: root.dark-color;
            current-date: root.current-date;
            current-screen <=> root.current-screen;

            farm-has-items: root.has-farms;
            current-page <=> root.farm-current-page;
            farms <=> root.farms;

            add-farm => { root.farm-current-page = "form"; }
            save-farm(farm) => {root.save-farm(farm);}
            edit-farm(farm) => {
                root.farm = farm;
                root.farm-current-page = "form";
            }
            delete-farm(id) => {root.delete-farm(id);}
        }

        if root.current-screen == "crops": CropsScreen {
            has-items: root.has-crops;
            current-page <=> root.crop-current-page;
            crops <=> root.crops;
            current-date: root.current-date;

            add-crop => {root.crop-current-page = "form";}
            save-crop(crop) => {root.save-crop(crop);}
            edit-crop(crop) => {
                root.crop = crop;
                root.crop-current-page = "form";
            }
            delete-crop(id) => {root.delete-crop(id);}
        }

        if root.current-screen == "activities": ActivitiesScreen {
            has-items: root.has-activities;
            current-page <=> root.activities-current-page;
            activities <=> root.activities;
            current-date: root.current-date;
            crop-names: root.crop-names;

            add-activity => {
                root.activities-current-page = "form";
            }

            save-activity(activity) => {
                root.save-activity(activity);
            }

            edit-activity(activity) => {
                root.activity = activity;
                root.activities-current-page = "form";
            }
            delete-activity(id) => {
                root.delete-activity(id);
            }
        }

        if root.current-screen == "harvest": HarvestScreen {

        }

        if root.current-screen == "reports": ReportsScreen {

        }

        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }

        Rectangle {

            Text {
                text: "Works offline · Your records stay on your device";
                color: #59665c;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        
    }

Rectangle {
    height: 96px;
    background: #cdd6c9;
    drop-shadow-blur: 5px;
    drop-shadow-color: gray;
    drop-shadow-offset-y: -1px;
    VerticalLayout {
        padding: 0px;
        HorizontalLayout {
            padding: 8px;
            spacing: 0px;
            
            VerticalLayout {
                UiButtonImg {
                    width: 20%;
                    height: 64px;
                    img: @image-url("../Icons/Home/Bird-House.png");
                    clicked => {
                        root.current-screen = "home";
                    }
                }
                ActiveTabIndicator {
                    active: current-screen == "home" ? true : false;
                }
            }
            
            VerticalLayout {
                UiButtonImg {
                    width: 20%;
                    height: 64px;
                    img: @image-url("../Icons/Sprout/Sprout.png");
                    clicked => {
                        root.current-screen = "crops";
                    }
                }
                ActiveTabIndicator {
                    active: current-screen == "crops" ? true : false;
                }
            }

            VerticalLayout {
                UiButtonImg {
                    width: 20%;
                    height: 64px;
                    img: @image-url("../Icons/List/Task-List.png");
                    clicked => {
                        root.current-screen = "activities";
                    }
                }
                ActiveTabIndicator {
                    active: current-screen == "activities" ? true : false;
                }
            }

            VerticalLayout {
                UiButtonImg {
                width: 20%;
                height: 64px;
                    img: @image-url("../Icons/Wheat/Wheat.png");
                    clicked => {
                        root.current-screen = "harvest";
                    }
                }
                ActiveTabIndicator {
                    active: current-screen == "harvest" ? true : false;
                }
            }

            VerticalLayout {
                UiButtonImg {
                    width: 20%;
                    height: 64px;
                    img: @image-url("../Icons/Graph/Graph-Stats.png");
                    clicked => {
                        root.current-screen = "reports";
                    }
                }
                ActiveTabIndicator {
                    active: current-screen == "reports" ? true : false;
                }
            }
    
        }
        Rectangle {
            height: 16px;
            background: transparent;
        }
    }

}

    }

}