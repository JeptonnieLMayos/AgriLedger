import { VerticalBox, Date, TextEdit } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";
import { UILineEdit } from "../UI/ui_line_edit.slint";
import { UIComboBox } from "../UI/ui_combo_box.slint";
import { UIDatePicker } from "../UI/ui_date_picker.slint";
import { FarmData } from "../models/farm_data.slint";
import { UITextEdit } from "../UI/ui_text_edit.slint";

export component FarmOverview inherits VerticalBox {
    callback save-farm(
        FarmData
    );
    callback cancel();
    
    spacing: 10px;

    in property <Date> current-date;
    in property <bool> editing: false;
    in-out property <FarmData> farm; 


    Text {
        text: root.editing ? "Edit" : "New";
        font-size: 18px;
        font-weight: 700;
        color: #022817;
    }

    Text {
        text: "Name";
        color: #022817;
    }


    UILineEdit {
        _text <=> root.farm.name;
    }



    Text {
        text: "Description";
        color: #022817;
    }


    UILineEdit {
        _text <=> root.farm.description;
    }

    Text {
        text: "notes:";
        color: #022817;
    }

    UILineEdit {
        _text <=> root.farm.notes;
    }

    UiButton {
        label: root.editing ? "Save Changes" : "Save";
        clicked => {
            if root.farm.name == "" {
                return;
            }
            root.save-farm(
                farm
            );
        }
    }

    UiButton {
        label: "Cancel";
        button-color: #59665c;
        clicked => {
            root.cancel();
        }
    }
}