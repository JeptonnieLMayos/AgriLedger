import { VerticalBox, Date, TextEdit, HorizontalBox } from "std-widgets.slint";
import { UiButton } from "../components/ui_button.slint";
import { UILineEdit } from "../components/ui_line_edit.slint";
import { UIComboBox } from "../components/ui_combo_box.slint";
import { UIDatePicker } from "../components/ui_date_picker.slint";
import { FarmData } from "../models/farm_data.slint";
import { UITextEdit } from "../components/ui_text_edit.slint";

export component FarmOverview inherits VerticalBox {

    Rectangle {
        background: #f4fff5;
        border-radius: 12px;
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            HorizontalBox {
                padding: 0px;
                Text {
                    text: "My Farm";
                    color: black;
                    font-weight: 800;
                    font-size: 14px;
                    horizontal-alignment: start;
                    vertical-alignment: center;
                }
                VerticalBox {
                    spacing: 0px;
                    padding: 0px;
                    Image {
                        source: @image-url("../../Icons/Menu/Navigation-Menu-Horizontal-1.png");
                        colorize: #285943;
                    }
                    Rectangle {
                        width: 24px;
                        vertical-stretch: 1;
                    }
                }
            }
            Text {
                text: "This is my farm description. ";
                color: gray;
                // font-italic: true;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: start;
                wrap: word-wrap;
                overflow: elide;
            }
            Text {
                text: "This is my farm notes. ";
                color: gray;
                font-italic: true;
                font-size: 12px;
                // font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: start;
                wrap: word-wrap;
            }

        }
    }

    Text {
        text: "Field Groups";
        color: black;
        font-weight: 700;
        font-size: 16px;
    }

    property <[int]> gr: [1,2,3,4];

    for g in gr: Rectangle {
        background: #f4fff5;
        border-radius: 12px;
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            HorizontalBox {
                padding: 0px;
                Text {
                    text: "Group " + g;
                    color: black;
                    font-weight: 800;
                    font-size: 14px;
                    horizontal-alignment: start;
                    vertical-alignment: center;
                }
                VerticalBox {
                    spacing: 0px;
                    padding: 0px;
                    Image {
                        source: @image-url("../../Icons/Menu/Navigation-Menu-Horizontal-1.png");
                        colorize: #285943;
                    }
                    Rectangle {
                        width: 24px;
                        vertical-stretch: 1;
                    }
                }
            }
            property<[int]> items: [1,2,3,4,5];
            for i in items: Text {
                text: "Field " + i;
                color: gray;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: start;
                wrap: word-wrap;
                overflow: elide;
            }

        }
    }
}