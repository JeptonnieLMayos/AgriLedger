
import { VerticalBox } from "std-widgets.slint";
import { UiButton } from "../UI/ui_button.slint";

export component FieldsScreen inherits Rectangle {
    callback go-back();

    background: #afecba;

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        

        Text {
            text: "Fields";
            font-size: 18px;
            font-weight: 700;
            color: #022817;
        }

        UiButton {
            label: "Back";
            clicked => {
                root.go-back();
            }
        }
    }
}

